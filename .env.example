# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/stock_portfolio_analyzer

# Kite Connect
KITE_API_KEY=
KITE_API_SECRET=

# Optional dashboard origin allowed for validated Kite login return addresses.
# It is not used as an automatic callback redirect destination.
FRONTEND_URL=http://localhost:5173

# Optional external data providers
TAVILY_API_KEY=
NEWSAPI_KEY=
OPENAI_API_KEY=

# Ollama Cloud (uses monthly account credits; set OLLAMA_MODE=local for local models)
OLLAMA_MODE=cloud
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_BASE_URL=http://localhost:11434

# Optional Langfuse Cloud tracing (EU region; use https://us.cloud.langfuse.com for US)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
